meta {
  name: Change password (wrong current password)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{buyerToken}}
}

body:json {
  {
    "currentPassword": "not the password",
    "newPassword": "a long bruno password"
  }
}

tests {
  test("status is 422", function () {
    expect(res.status).to.equal(422);
  });
}

docs {
  EP-08. Sent with a wrong current password so the seeded account keeps its password.
}
