meta {
  name: Log in as buyer
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{buyerEmail}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("buyerToken", res.body.accessToken);
  bru.setVar("buyerRefresh", res.body.refreshToken);
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("response", function () {
    expect(res.body.tokenType).to.equal("Bearer");
  });
}

docs {
  EP-03. Stores the access and refresh tokens as runtime variables.
}
