meta {
  name: Reset password (invalid token)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "not-a-real-token",
    "newPassword": "a long bruno password"
  }
}

tests {
  test("status is 400", function () {
    expect(res.status).to.equal(400);
  });

  test("response", function () {
    expect(res.body.code).to.equal("invalid_token");
  });
}

docs {
  EP-07. A real token comes from the reset email in Mailpit; this request shows the failure answer.
}
