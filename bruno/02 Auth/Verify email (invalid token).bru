meta {
  name: Verify email (invalid token)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/verify-email
  body: json
  auth: none
}

body:json {
  {
    "token": "not-a-real-token"
  }
}

tests {
  test("status is 400", function () {
    expect(res.status).to.equal(400);
  });

  test("response", function () {
    expect(res.body.code).to.equal("invalid_token");
  });
}

docs {
  EP-02. A real token comes from the confirmation email; this request shows the failure answer.
}
