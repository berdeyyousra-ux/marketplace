meta {
  name: Create order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{orderKey}}
}

auth:bearer {
  token: {{buyerToken}}
}

body:json {
  {
    "productIds": [
      "{{productId}}"
    ]
  }
}

script:pre-request {
  bru.setVar("orderKey", bru.interpolate("{{$randomUUID}}"));
}

script:post-response {
  bru.setVar("orderId", res.body.id);
  bru.setVar("orderItemId", res.body.items[0].id);
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("response", function () {
    expect(res.body.status).to.equal("Pending");
  });
}

docs {
  EP-30. Idempotent: the same Idempotency-Key with the same body returns the first answer.
}
