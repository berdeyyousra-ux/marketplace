meta {
  name: Download link
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/downloads/{{orderItemId}}/link
  body: none
  auth: bearer
}

auth:bearer {
  token: {{buyerToken}}
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("response", function () {
    expect(res.body.url).to.contain("sig=");
  });
}

docs {
  EP-50. A signed URL valid for five minutes; each call counts against the download limit.
}
