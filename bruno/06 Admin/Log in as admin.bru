meta {
  name: Log in as admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("adminToken", res.body.accessToken);
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
}
