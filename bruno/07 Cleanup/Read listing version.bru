meta {
  name: Read listing version
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sellerToken}}
}

script:post-response {
  bru.setVar("productEtag", res.headers.etag);
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
}
