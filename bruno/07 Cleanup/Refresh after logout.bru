meta {
  name: Refresh after logout
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{buyerRefresh}}"
  }
}

tests {
  test("status is 401", function () {
    expect(res.status).to.equal(401);
  });

  test("response", function () {
    expect(res.body.code).to.equal("invalid_refresh_token");
  });
}

docs {
  EP-04 with the revoked token.
}
