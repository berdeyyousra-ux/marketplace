{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "ExposeDocs": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
