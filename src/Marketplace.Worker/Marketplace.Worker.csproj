<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The same store as the Api, so Ai:* and other local secrets reach the Worker in Development. -->
    <UserSecretsId>18f7d163-08a0-473c-9815-e6f056f2c564</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Marketplace.Application/Marketplace.Application.csproj" />
    <ProjectReference Include="../Marketplace.Infrastructure/Marketplace.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Kestrel serves the health endpoints only (section 15.7). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>
